<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifier</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        /* Updated header to match Bootstrap Album dark theme */
        .header {
            background-color: #343a40;
            padding: 1rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.075);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 100%;
        }

        .header-title {
            color: #fff;
            font-size: 1.25rem;
            font-weight: 500;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .notification-badge-container {
            position: relative;
            cursor: pointer;
        }

        .notification-icon {
            color: #fff;
            font-size: 1.5rem;
        }

        .notification-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: #dc3545;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: bold;
        }

        .menu-icon {
            color: #fff;
            font-size: 1.5rem;
            cursor: pointer;
            border: 1px solid rgba(255,255,255,0.3);
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
        }

        .menu-icon:hover {
            background-color: rgba(255,255,255,0.1);
        }
        /* </CHANGE> */

        /* Updated main container styling */
        .container {
            max-width: 960px;
            padding: 2rem 1rem;
        }
        /* </CHANGE> */

        /* Redesigned notification cards to match Bootstrap Album cards */
        .notification-card {
            background: white;
            border: 1px solid rgba(0,0,0,.125);
            border-radius: 0.375rem;
            margin-bottom: 1rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.075);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .notification-header {
            display: flex;
            align-items: center;
            padding: 1rem;
            cursor: pointer;
            background-color: #fff;
            transition: background-color 0.2s;
        }

        .notification-header:hover {
            background-color: #f8f9fa;
        }

        .chevron-icon {
            font-size: 1.25rem;
            color: #495057;
            transition: transform 0.3s ease;
            margin-right: 1rem;
        }

        .chevron-icon.expanded {
            transform: rotate(180deg);
        }

        .notification-title {
            flex: 1;
            font-size: 1rem;
            font-weight: 500;
            color: #212529;
            margin: 0;
        }

        .delete-btn {
            background: none;
            border: none;
            color: #6c757d;
            font-size: 1.25rem;
            cursor: pointer;
            padding: 0.25rem 0.5rem;
            transition: color 0.2s;
        }

        .delete-btn:hover {
            color: #dc3545;
        }

        .notification-body {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            border-top: 1px solid rgba(0,0,0,.125);
        }

        .notification-body.show {
            max-height: 500px;
        }

        .notification-content {
            padding: 1rem;
            color: #6c757d;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .notification-footer {
            padding: 0.75rem 1rem;
            background-color: #f8f9fa;
            border-top: 1px solid rgba(0,0,0,.125);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notification-time {
            color: #6c757d;
            font-size: 0.875rem;
        }

        .notification-actions {
            display: flex;
            gap: 0.5rem;
        }

        .btn-sm {
            padding: 0.25rem 0.75rem;
            font-size: 0.875rem;
        }
        /* </CHANGE> */

        .fade-out {
            animation: fadeOut 0.3s ease forwards;
        }

        @keyframes fadeOut {
            to {
                opacity: 0;
                transform: translateX(100%);
            }
        }

        /* Added empty state styling */
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: #6c757d;
        }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
        /* </CHANGE> */
    </style>
</head>
<body>
    <!-- Updated header structure to match Bootstrap Album -->
    <header class="header">
        <div class="header-content">
            <h1 class="header-title">
                <i class="bi bi-app-indicator"></i>
                Notifier
            </h1>
            <div class="header-actions">
                <div class="notification-badge-container">
                    <i class="bi bi-bell-fill notification-icon"></i>
                    <span class="notification-count" id="notificationCount">4</span>
                </div>
                <i class="bi bi-list menu-icon"></i>
            </div>
        </div>
    </header>
    <!-- </CHANGE> -->

    <div class="container">
        <div id="notificationList">
            <!-- Updated notification card structure -->
            <div class="notification-card" data-notification="1">
                <div class="notification-header" onclick="toggleNotification(1)">
                    <i class="bi bi-chevron-down chevron-icon" id="chevron-1"></i>
                    <h5 class="notification-title">Notification 1</h5>
                    <button class="delete-btn" onclick="deleteNotification(event, 1)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="notification-body" id="body-1">
                    <div class="notification-content">
                        <p>This is a detailed description of the first notification. It contains important information that the user needs to review. The content can be as long as needed to convey the message effectively.</p>
                    </div>
                    <div class="notification-footer">
                        <span class="notification-time">9 mins ago</span>
                        <div class="notification-actions">
                            <button class="btn btn-outline-secondary btn-sm">View</button>
                            <button class="btn btn-outline-secondary btn-sm">Edit</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="notification-card" data-notification="2">
                <div class="notification-header" onclick="toggleNotification(2)">
                    <i class="bi bi-chevron-down chevron-icon" id="chevron-2"></i>
                    <h5 class="notification-title">Battery is on 25%</h5>
                    <button class="delete-btn" onclick="deleteNotification(event, 2)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="notification-body" id="body-2">
                    <div class="notification-content">
                        <p>This is the description for notification 2. It provides additional context and details about this particular notification item.</p>
                    </div>
                    <div class="notification-footer">
                        <span class="notification-time">15 mins ago</span>
                        <div class="notification-actions">
                            <button class="btn btn-outline-secondary btn-sm">View</button>
                            <button class="btn btn-outline-secondary btn-sm">Edit</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="notification-card" data-notification="3">
                <div class="notification-header" onclick="toggleNotification(3)">
                    <i class="bi bi-chevron-down chevron-icon" id="chevron-3"></i>
                    <h5 class="notification-title">Notification 3</h5>
                    <button class="delete-btn" onclick="deleteNotification(event, 3)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="notification-body" id="body-3">
                    <div class="notification-content">
                        <p>Here's the content for notification 3. Each notification can have its own unique message and information.</p>
                    </div>
                    <div class="notification-footer">
                        <span class="notification-time">1 hour ago</span>
                        <div class="notification-actions">
                            <button class="btn btn-outline-secondary btn-sm">View</button>
                            <button class="btn btn-outline-secondary btn-sm">Edit</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="notification-card" data-notification="4">
                <div class="notification-header" onclick="toggleNotification(4)">
                    <i class="bi bi-chevron-down chevron-icon" id="chevron-4"></i>
                    <h5 class="notification-title">Notification 4</h5>
                    <button class="delete-btn" onclick="deleteNotification(event, 4)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="notification-body" id="body-4">
                    <div class="notification-content">
                        <p>This is the fourth notification with its own description and details for the user to review.</p>
                    </div>
                    <div class="notification-footer">
                        <span class="notification-time">2 hours ago</span>
                        <div class="notification-actions">
                            <button class="btn btn-outline-secondary btn-sm">View</button>
                            <button class="btn btn-outline-secondary btn-sm">Edit</button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- </CHANGE> -->
        </div>

        <!-- Added empty state message -->
        <div id="emptyState" class="empty-state" style="display: none;">
            <i class="bi bi-inbox"></i>
            <h5>No notifications</h5>
            <p class="text-muted">You're all caught up!</p>
        </div>
        <!-- </CHANGE> -->
    </div>

    <script>
        function toggleNotification(id) {
            const body = document.getElementById(`body-${id}`);
            const chevron = document.getElementById(`chevron-${id}`);
            
            body.classList.toggle('show');
            chevron.classList.toggle('expanded');
        }

        function deleteNotification(event, id) {
            event.stopPropagation();
            
            const card = document.querySelector(`[data-notification="${id}"]`);
            card.classList.add('fade-out');
            
            setTimeout(() => {
                card.remove();
                updateNotificationCount();
                checkEmptyState();
            }, 300);
        }

        function updateNotificationCount() {
            const count = document.querySelectorAll('.notification-card').length;
            const badge = document.getElementById('notificationCount');
            badge.textContent = count;
            
            if (count === 0) {
                badge.style.display = 'none';
            }
        }

        function checkEmptyState() {
            const notificationList = document.getElementById('notificationList');
            const emptyState = document.getElementById('emptyState');
            const count = document.querySelectorAll('.notification-card').length;
            
            if (count === 0) {
                notificationList.style.display = 'none';
                emptyState.style.display = 'block';
            }
        }
        // </CHANGE>
    </script>
</body>
</html>
